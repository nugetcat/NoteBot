import { Button, LineEdit, TextEdit } from "std-widgets.slint";

export component NoteWindow inherits Window {
    in-out property <string> note-text: "";
    in-out property <color> paper-color: #fdfdca;
    in-out property <float> text-scale: 1.0;
    in-out property <bool> show-color-picker: false;
    in-out property <string> custom-color-text: "#FDFDCA";
    in-out property <string> color-error: "";

    callback note-text-edited(string);
    callback new-note();
    callback delete-note();
    callback toggle-color-picker();
    callback select-palette-color(int);
    callback apply-custom-color(string);
    callback zoom-in();
    callback zoom-out();

    title: "NoteBot";
    no-frame: true;
    // Supported by Slint's winit backend; keeps borderless notes resizable.
    resize-border-width: 6px;
    background: paper-color;
    preferred-width: 270px;
    preferred-height: 220px;
    min-width: 170px;
    min-height: 130px;

    VerticalLayout {
        padding: 7px;
        spacing: 5px;

        HorizontalLayout {
            spacing: 4px;
            Button { text: "A−"; clicked => { root.zoom-out(); } }
            Button { text: "A+"; clicked => { root.zoom-in(); } }
            Button { text: "Color"; clicked => { root.toggle-color-picker(); } }
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
                WindowMoveArea {}
            }
            Button { text: "+"; clicked => { root.new-note(); } }
            Button { text: "×"; clicked => { root.delete-note(); } }
        }

        if root.show-color-picker: VerticalLayout {
            spacing: 4px;

            HorizontalLayout {
                spacing: 4px;
                for swatch[index] in [#fdfdca, #ffd7ad, #d9f3fb, #d1fecb, #f6d3f6, #ddd9fe, #fed1cb, #ffffff]: Rectangle {
                    width: 25px;
                    height: 22px;
                    background: swatch;
                    border-width: 1px;
                    border-color: #777777;
                    TouchArea { clicked => { root.select-palette-color(index); } }
                }
            }

            HorizontalLayout {
                spacing: 4px;
                Text { text: "HEX"; vertical-alignment: center; }
                LineEdit {
                    text <=> root.custom-color-text;
                    placeholder-text: "#RRGGBB";
                    horizontal-stretch: 1;
                }
                Button { text: "Apply"; clicked => { root.apply-custom-color(root.custom-color-text); } }
            }
            Text { text: root.color-error; color: #a00000; visible: root.color-error != ""; }
        }

        TextEdit {
            text <=> root.note-text;
            edited(text) => { root.note-text-edited(text); }
            wrap: word-wrap;
            font-size: 14px * root.text-scale;
            vertical-stretch: 1;
        }
    }
}
